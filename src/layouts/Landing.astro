---
import '@fontsource-variable/montserrat/wght.css';
import '@fontsource-variable/montserrat/wght-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import BlockMenu from '../components/BlockMenu.astro';
import Hero from '../components/Hero.astro';
import Trust from '../components/Trust.astro';
import Sections from '../components/Sections.astro';
import Footer from '../components/Footer.astro';
import { locales, settings, type Locale } from '../content/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = locales[locale];
---
<!doctype html>
<html lang={t.lang} class:list={{ 'show-dynamic': settings.showDynamicLabels }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#FFCB00" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'uz' ? 'uz_UZ' : 'ru_RU'} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content="/og.jpg" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body id="top">
    <a class="skip" href="#main">{t.a11y.skip}</a>
    <Header t={t} locale={locale} />
    <BlockMenu t={t} />
    <main id="main" tabindex="-1">
      <Hero t={t} />
      <Trust t={t} />
      <Sections t={t} />
    </main>
    <Footer t={t} />
    <script src="../scripts/navigation.ts"></script>
  </body>
</html>
