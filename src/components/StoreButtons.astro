---
import { settings, type AppId, type Content } from '../content/site';
interface Props { t: Content; app: AppId; class?: string }
const { t, app, class: className } = Astro.props;
const links = settings.apps[app];
const buttons = [
  { id: 'google', href: links.googlePlay, key: `apps.${app}.google_play_url`, top: t.store.googleTop, name: t.store.googleName },
  { id: 'apple', href: links.appStore, key: `apps.${app}.app_store_url`, top: t.store.appleTop, name: t.store.appleName },
];
---
<ul class:list={['stores', className]} aria-label={`${t.a11y.stores}: ${t.apps[app].name}`}>
  {buttons.map((b) => (
    <li>
      {b.href ? (
        <a class="store" href={b.href} target="_blank" rel="noopener" data-store={b.id} data-app={app} data-dynamic={b.key}>
          {b.id === 'google'
            ? <Fragment set:html={'<svg width="26" height="28" viewBox="0 0 26 28" aria-hidden="true"><path fill="#4285F4" d="M1.6 1.2 14.3 14 1.6 26.8c-.4-.3-.6-.8-.6-1.4V2.6c0-.6.2-1.1.6-1.4z"/><path fill="#34A853" d="M18.6 9.7 14.3 14 1.6 1.2c.5-.4 1.2-.5 1.9-.1z"/><path fill="#EA4335" d="M18.6 18.3 3.5 26.9c-.7.4-1.4.3-1.9-.1L14.3 14z"/><path fill="#FBBC04" d="m18.6 9.7 5 2.8c1.2.7 1.2 2.3 0 3l-5 2.8-4.3-4.3z"/></svg>'} />
            : <Fragment set:html={'<svg width="24" height="28" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true"><path d="M318.700 268.700c-.2-36.700 16.400-64.400 50-84.800-18.800-26.900-47.200-41.700-84.700-44.600-35.500-2.800-74.300 20.700-88.500 20.700-15 0-49.400-19.700-76.400-19.700C63.300 141.200 4 184.800 4 273.500q0 39.300 14.400 81.200c12.800 36.700 59 126.700 107.200 125.200 25.200-.6 43-17.900 75.800-17.900 31.800 0 48.300 17.900 76.400 17.900 48.600-.7 90.400-82.500 102.600-119.300-65.200-30.700-61.700-90-61.700-91.900zm-56.600-164.200c27.300-32.400 24.800-61.900 24-72.500-24.100 1.400-52 16.400-67.900 34.900-17.500 19.800-27.800 44.300-25.600 71.900 26.100 2 49.900-11.400 69.500-34.300z"/></svg>'} />}
          <span><small>{b.top}</small><b>{b.name}</b></span>
          <span class="sr-only">{t.a11y.newTab}</span>
        </a>
      ) : (
        <span class="store store--ph" data-store={`${b.id}-placeholder`} data-app={app} data-placeholder={`${app}-${b.id}`} data-dynamic={b.key}>
          {b.id === 'google'
            ? <Fragment set:html={'<svg width="26" height="28" viewBox="0 0 26 28" aria-hidden="true"><path fill="#4285F4" d="M1.6 1.2 14.3 14 1.6 26.8c-.4-.3-.6-.8-.6-1.4V2.6c0-.6.2-1.1.6-1.4z"/><path fill="#34A853" d="M18.6 9.7 14.3 14 1.6 1.2c.5-.4 1.2-.5 1.9-.1z"/><path fill="#EA4335" d="M18.6 18.3 3.5 26.9c-.7.4-1.4.3-1.9-.1L14.3 14z"/><path fill="#FBBC04" d="m18.6 9.7 5 2.8c1.2.7 1.2 2.3 0 3l-5 2.8-4.3-4.3z"/></svg>'} />
            : <Fragment set:html={'<svg width="24" height="28" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true"><path d="M318.700 268.700c-.2-36.700 16.400-64.400 50-84.800-18.800-26.900-47.200-41.700-84.700-44.600-35.500-2.800-74.300 20.700-88.500 20.700-15 0-49.400-19.700-76.400-19.700C63.300 141.200 4 184.800 4 273.500q0 39.300 14.400 81.200c12.800 36.700 59 126.700 107.200 125.200 25.200-.6 43-17.900 75.800-17.900 31.800 0 48.300 17.900 76.400 17.900 48.600-.7 90.400-82.500 102.600-119.300-65.200-30.700-61.700-90-61.700-91.900zm-56.600-164.200c27.300-32.400 24.800-61.900 24-72.500-24.100 1.400-52 16.400-67.900 34.900-17.500 19.800-27.800 44.300-25.600 71.900 26.100 2 49.900-11.400 69.500-34.300z"/></svg>'} />}
          <span><small>{t.placeholder.tag}: {t.placeholder.appStore}</small><b>{b.name}</b></span>
        </span>
      )}
    </li>
  ))}
</ul>
