---
import Contacts from './Contacts.astro';
import { withBase } from '../lib/paths';
import StoreButtons from './StoreButtons.astro';
import { settings, type Content } from '../content/site';
interface Props { t: Content }
const { t } = Astro.props;
const links = [
  ['marketplace', t.menu.marketplace.title], ['trucks', t.menu.trucks.title], ['jobs', t.menu.jobs.title],
  ['fleet', t.menu.fleet.title], ['dealer', t.menu.dealer.title],
];
---
<footer class="footer">
  <div class="container footer__grid">
    <div>
      <img src={withBase('/brand/logo.svg')} alt={t.a11y.logoAlt} width="96" height="97" loading="lazy" />
      <p>{t.footer.about}</p>
    </div>
    <nav aria-labelledby="footer-sections">
      <h2 id="footer-sections">{t.footer.sections}</h2>
      <ul>{links.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
    </nav>
    <div id="support" tabindex="-1">
      <h2>{t.footer.support}</h2>
      <p>{t.footer.supportNote}</p>
      <Contacts t={t} scope="support" data={settings.contacts.support} />
    </div>
    <div>
      <h2>{t.footer.app}</h2>
      {(['ecommerce', 'autopark'] as const).map((app) => (
        <div class="footer__app">
          <p class="footer__app-name">{t.apps[app].name}</p>
          <StoreButtons t={t} app={app} class="stores--stack" />
        </div>
      ))}
    </div>
  </div>
  <div class="container footer__bottom"><small>{t.footer.copyright}</small></div>
</footer>
